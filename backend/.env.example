# =============================================================================
# Backend environment — copy sang .env và điền giá trị thật.
# KHÔNG commit file .env lên git.
# =============================================================================

# JWT signing secret. Dùng `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
# để generate random secret cho production.
JWT_SECRET=dev-only-secret-CHANGE-ME-PLEASE

# Token expiration. MVP: 7d. Production: access 15m + refresh 7d.
JWT_EXPIRES_IN=7d

# Server port.
PORT=3001

# Frontend URL cho CORS. Default: Vite dev server.
FRONTEND_ORIGIN=http://localhost:3000

# Path đến SQLite file. Default: ./database.db
DB_PATH=./database.db

# NODE_ENV: development | production
NODE_ENV=development