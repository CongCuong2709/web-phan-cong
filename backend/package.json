    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "vitest": "^5.0.3"
  }
